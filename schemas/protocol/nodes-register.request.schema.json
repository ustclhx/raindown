{
  "$id": "https://raindown.local/schemas/protocol/nodes-register.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "节点 id，节点首次启动时生成并保存在 state/node-id"
    },
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_-]*(:.+)?$",
        "description": "节点能力，例如 browser、executor:fake、repo:/path/to/repo"
      },
      "description": "节点能力，含执行器贡献的 executor:<type>"
    },
    "executors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
          },
          "mode": {
            "description": "交互式（如 codex-orca）或无头（如 claude-sdk）；由变更 ② 使用",
            "type": "string",
            "enum": [
              "interactive",
              "headless"
            ]
          },
          "adapter_capabilities": {
            "default": {
              "approval_requests": "none",
              "inject_while_running": false,
              "resume_session": false,
              "raindown_mcp": false,
              "out_of_band_detection": false
            },
            "type": "object",
            "properties": {
              "approval_requests": {
                "type": "string",
                "enum": [
                  "structured",
                  "inferred",
                  "none"
                ]
              },
              "inject_while_running": {
                "type": "boolean"
              },
              "resume_session": {
                "type": "boolean",
                "description": "进程结束后仍能继续同一个 harness 会话"
              },
              "raindown_mcp": {
                "type": "boolean"
              },
              "out_of_band_detection": {
                "type": "boolean"
              },
              "credential_isolation": {
                "description": "凭证隔离的施加层声明；旧节点不上报时视为未知（按 none 处理）",
                "type": "object",
                "properties": {
                  "layers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "seatbelt",
                        "native",
                        "separate_user",
                        "none"
                      ]
                    },
                    "description": "按角色沙箱设置声明的施加层；已知设置：danger-full-access、workspace-write、read-only、bash-sandbox-off、bash-sandbox-on、in-node。未列出的设置视为 none"
                  },
                  "enforced": {
                    "type": "boolean",
                    "description": "适配器当前是否真正施加上述隔离。false 表示只是声明将要支持的施加层，尚未施加，不能显示为已隔离；自检结果另行上报"
                  }
                },
                "required": [
                  "layers",
                  "enforced"
                ],
                "title": "Credential isolation"
              }
            },
            "required": [
              "approval_requests",
              "inject_while_running",
              "resume_session",
              "raindown_mcp",
              "out_of_band_detection"
            ],
            "title": "Adapter capabilities"
          },
          "task_inputs": {
            "description": "执行器会把派工的 inputs 放进输入并由节点确认（PR 直通，harness-neutral 8.4）；旧节点没有该字段时中枢不随派工下发输入",
            "type": "boolean"
          }
        },
        "required": [
          "type"
        ],
        "title": "Executor info"
      }
    },
    "concurrency": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "node_id",
    "hostname",
    "version",
    "capabilities"
  ],
  "additionalProperties": false,
  "title": "POST /v1/nodes"
}
