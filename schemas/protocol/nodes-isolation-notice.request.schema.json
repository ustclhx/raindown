{
  "$id": "https://raindown.local/schemas/protocol/nodes-isolation-notice.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "signal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "const": "mds_reset"
        },
        "files": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": "被删除的 mds/ 条目名（只有文件名）"
        },
        "repeats": {
          "description": "各文件在同一基线下被重置的次数（审查第三轮：重复重置只计数）",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "inbox": {
          "description": "none：只写任务事件（重复重置的计数）；repeated：写“反复重置”的收件箱条目；缺省写普通的重置条目",
          "type": "string",
          "enum": [
            "none",
            "repeated"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "id",
        "kind",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "task_id",
    "signal"
  ],
  "additionalProperties": false,
  "title": "POST /v1/nodes/:id/isolation-notices"
}
