{
  "$id": "https://raindown.local/schemas/protocol/leases-renew.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lease_token": {
      "type": "string",
      "minLength": 16
    },
    "dispatch_token_sha256": {
      "description": "节点当前派工凭证的 SHA-256 前 16 位；不匹配、或中枢没有当前凭证时重新下发；缺失且中枢已有当前凭证时不轮换",
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "report_conflict": {
      "description": "上报与观察矛盾；须与同批 report_seq 相同",
      "type": "object",
      "properties": {
        "report_seq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "observed": {
          "type": "string",
          "enum": [
            "idle",
            "busy",
            "no_progress"
          ]
        }
      },
      "required": [
        "report_seq",
        "observed"
      ],
      "additionalProperties": false
    },
    "activity": {
      "default": [],
      "description": "自上次续约以来的活动",
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
          },
          "kind": {
            "type": "string",
            "enum": [
              "output",
              "status",
              "heartbeat"
            ],
            "description": "output 输出片段、status 状态提示、heartbeat 执行器心跳（无内容）"
          },
          "text": {
            "description": "输出片段或状态说明",
            "type": "string",
            "maxLength": 16384
          },
          "data": {
            "description": "执行器专用的结构化信息",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "ts",
          "kind"
        ],
        "title": "Task activity",
        "description": "执行器上报的一条活动"
      }
    },
    "report_seq": {
      "description": "确认已消费本派工的上报，确认后续约不再下发",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "description": "开始执行验收命令时带上，中枢写入 task.verifying",
      "type": "string",
      "const": "verifying"
    },
    "blocked": {
      "description": "worker 卡住但仍活着（交互式执行器）：中枢写入 task.blocked(lease_held=true)，租约照常续约",
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "approval_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "节点上报的授权弹窗 SHA-256，用于恢复时核对原请求"
        },
        "reason": {
          "type": "string",
          "enum": [
            "awaiting_approval",
            "question",
            "no_progress",
            "crashed",
            "workdir_missing",
            "node_lost",
            "other"
          ],
          "description": "卡住原因：awaiting_approval 等审批、question 提问、no_progress 无进展、crashed 崩溃、workdir_missing 工作目录或会话丢失、node_lost 节点掉线（租约过期）、other 其他"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "tail": {
          "description": "末尾输出：最多 200 行，每行最多 2000 字符",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "session": {
          "description": "执行器会话 id；重新排队时随 resume 带给下一次执行",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "basis": {
          "type": "string",
          "enum": [
            "reported",
            "inferred"
          ]
        },
        "question": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "options": {
              "minItems": 2,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "required": [
                  "label",
                  "description"
                ],
                "additionalProperties": false
              }
            },
            "recommended": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "text",
            "options",
            "recommended"
          ],
          "additionalProperties": false
        },
        "missing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "tried": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "decision_id": {
          "description": "策略判定为 supervisor 档位时，这次卡住对应的 policy.decided seq",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request": {
          "description": "带 decision_id 时：判定所针对的请求（工具、命令与理由）",
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "paths": {
              "description": "请求涉及的路径（与预检时送去判定的路径相同）",
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "reason": {
              "description": "执行器给出的请求理由（例如 Codex 弹窗的 Reason 一行）",
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "tool"
          ],
          "additionalProperties": false,
          "title": "Blocked request"
        },
        "no_delegate": {
          "description": "true：这次卡住不得委托给 supervisor（例如 supervisor 的批准因请求已变而被丢弃）",
          "type": "boolean"
        },
        "diff_stat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "相对任务基点的 git diff --stat 与未提交改动；最多 8192 字符，中枢入账时截到 2000"
        }
      },
      "required": [
        "reason",
        "message"
      ],
      "additionalProperties": false
    },
    "out_of_band": {
      "description": "自上次续约以来的带外操作；每个信号的 id 在重试时不变",
      "maxItems": 100,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "type": "string",
                "const": "approval_outside_raindown"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "message": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": [
              "id",
              "kind",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "type": "string",
                "const": "session_removed"
              },
              "command": {
                "type": "string",
                "maxLength": 16384
              },
              "message": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "type": "string",
                "const": "mds_reset"
              },
              "files": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": "被删除的 mds/ 条目名（只有文件名）"
              },
              "repeats": {
                "description": "各文件在同一基线下被重置的次数（审查第三轮：重复重置只计数）",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "inbox": {
                "description": "none：只写任务事件（重复重置的计数）；repeated：写“反复重置”的收件箱条目；缺省写普通的重置条目",
                "type": "string",
                "enum": [
                  "none",
                  "repeated"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": [
              "id",
              "kind",
              "files"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "resumed": {
      "description": "worker 未经回复自行恢复（或即将结束）：中枢写入 task.unblocked",
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "inputs_delivered": {
      "description": "已送进运行中 worker 的输入（响应 inputs 的 input_seq）；中枢写 task.input_delivered",
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "inputs_dispatched": {
      "description": "已随派工输入交给执行器的输入（lease.inputs 的 input_seq）；中枢确认后才记为送达",
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "branch": {
      "description": "执行器创建的任务分支与 worktree，以及节点在任务首次上报时对执行器解析出的登记仓库的快照（D15，写类适配器启动前）：中枢在续约生效后写入 task.branch_reported（每个任务一次；worktree 缺失的旧任务可补报一次 worktree，不补快照），结果见响应的 branch_report",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$",
          "description": "执行器创建的任务分支，例如 ustclhx/t-1"
        },
        "worktree": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^\\/[^\\0\\n\\r]*$",
          "description": "节点上解析符号链接后的绝对路径"
        },
        "repo_snapshot": {
          "type": "object",
          "properties": {
            "remote_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "登记仓库 origin 的地址（只接受 github.com）"
            },
            "default_branch": {
              "description": "登记仓库的默认分支；取不到时省略（push_to 随之不满足）",
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "remote_url"
          ],
          "additionalProperties": false,
          "title": "Repo snapshot"
        }
      },
      "required": [
        "branch",
        "worktree"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "lease_token"
  ],
  "additionalProperties": false,
  "title": "POST /v1/leases/:id/renew"
}
