{
  "$id": "https://raindown.local/schemas/events/node.registered.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "账本序号，单调递增"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
    },
    "type": {
      "type": "string",
      "const": "node.registered"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
      "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
    },
    "payload": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "description": "节点 id，节点首次启动时生成并保存在 state/node-id"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[a-z][a-z0-9_-]*(:.+)?$",
            "description": "节点能力，例如 browser、executor:fake、repo:/path/to/repo"
          }
        },
        "executors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$",
                "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
              },
              "mode": {
                "description": "交互式（如 codex-orca）或无头（如 claude-sdk）；由变更 ② 使用",
                "type": "string",
                "enum": [
                  "interactive",
                  "headless"
                ]
              },
              "adapter_capabilities": {
                "default": {
                  "approval_requests": "none",
                  "inject_while_running": false,
                  "resume_session": false,
                  "raindown_mcp": false,
                  "out_of_band_detection": false
                },
                "type": "object",
                "properties": {
                  "approval_requests": {
                    "type": "string",
                    "enum": [
                      "structured",
                      "inferred",
                      "none"
                    ]
                  },
                  "inject_while_running": {
                    "type": "boolean"
                  },
                  "resume_session": {
                    "type": "boolean",
                    "description": "进程结束后仍能继续同一个 harness 会话"
                  },
                  "raindown_mcp": {
                    "type": "boolean"
                  },
                  "out_of_band_detection": {
                    "type": "boolean"
                  },
                  "credential_isolation": {
                    "description": "凭证隔离的施加层声明；旧节点不上报时视为未知（按 none 处理）",
                    "type": "object",
                    "properties": {
                      "layers": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "seatbelt",
                                "native",
                                "separate_user",
                                "none"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            }
                          ]
                        },
                        "description": "按角色沙箱设置声明的施加层（已知取值：seatbelt、native、separate_user、none；不认识的取值按 none）；已知设置：danger-full-access、workspace-write、read-only、bash-sandbox-off、bash-sandbox-on、in-node。未列出的设置视为 none"
                      },
                      "enforced": {
                        "type": "boolean",
                        "description": "适配器当前是否真正施加上述隔离。false 表示只是声明将要支持的施加层，尚未施加，不能显示为已隔离；自检结果另行上报"
                      }
                    },
                    "required": [
                      "layers",
                      "enforced"
                    ],
                    "additionalProperties": false,
                    "title": "Credential isolation"
                  }
                },
                "required": [
                  "approval_requests",
                  "inject_while_running",
                  "resume_session",
                  "raindown_mcp",
                  "out_of_band_detection"
                ],
                "additionalProperties": false,
                "title": "Adapter capabilities"
              },
              "task_inputs": {
                "description": "执行器会把派工的 inputs 放进输入并由节点确认（PR 直通，harness-neutral 8.4）；旧节点没有该字段时中枢不随派工下发输入",
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "adapter_capabilities"
            ],
            "additionalProperties": false,
            "title": "Executor info"
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "isolation_probe": {
          "type": "object",
          "properties": {
            "ran_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
            },
            "macos_version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "运行时的 macOS 版本"
            },
            "runs": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "executor": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$",
                    "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
                  },
                  "setting": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$",
                    "description": "角色沙箱设置"
                  },
                  "declared_layer": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                    "description": "适配器为该沙箱设置声明的施加层"
                  },
                  "applied_layer": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                    "description": "探针实际运行时所用的施加层；适配器尚未施加时为 none"
                  },
                  "passed": {
                    "type": "boolean",
                    "description": "受保护项全部被拒绝、允许项全部可用（跳过与未验证不计入），且至少一个受保护项确实被拒绝"
                  },
                  "items": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
                          "description": "探针项标识，例如 read.hub_token"
                        },
                        "target": {
                          "description": "尝试访问的路径、套接字或 host:port；不含任何文件内容",
                          "type": "string",
                          "maxLength": 1024
                        },
                        "expected": {
                          "type": "string",
                          "enum": [
                            "deny",
                            "allow"
                          ]
                        },
                        "actual": {
                          "type": "string",
                          "enum": [
                            "deny",
                            "allow",
                            "skipped",
                            "unverified",
                            "error"
                          ]
                        },
                        "ok": {
                          "description": "实际是否符合预期；skipped / unverified 为 null（既不算通过也不算失败）",
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "detail": {
                          "description": "说明：错误码（如 EACCES）、跳过或未验证的原因",
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "item",
                        "expected",
                        "actual",
                        "ok"
                      ],
                      "additionalProperties": false,
                      "title": "Isolation probe item"
                    }
                  },
                  "error": {
                    "description": "探针无法运行的原因（例如隔离清单计算失败）；此时 passed 为 false",
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "message": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "executor",
                  "setting",
                  "declared_layer",
                  "applied_layer",
                  "passed",
                  "items"
                ],
                "additionalProperties": false,
                "title": "Isolation probe run"
              }
            }
          },
          "required": [
            "ran_at",
            "macos_version",
            "runs"
          ],
          "additionalProperties": false,
          "title": "Isolation probe report"
        }
      },
      "required": [
        "node_id",
        "hostname",
        "version",
        "capabilities",
        "executors",
        "concurrency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "seq",
    "ts",
    "type",
    "actor",
    "payload"
  ],
  "additionalProperties": false,
  "title": "node.registered"
}
