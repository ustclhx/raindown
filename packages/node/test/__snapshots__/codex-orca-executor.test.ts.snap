exports[`外层 seatbelt（worker-credential-isolation 4.2） 开关关闭：终端命令与之前逐字节一致（快照），不生成配置 1`] = `"cd <root>/orca/workspaces/product-res/t-orca-1 && exec env -u RAINDOWN_HUB_TOKEN -u RAINDOWN_HUB_TOKEN_FILE -u RAINDOWN_LEASE_TOKEN_FILE -u FLOW_LEASE_TOKEN_FILE -u RAINDOWN_HUB_URL -u FLOW_HUB_URL -u FLOW_HUB_TOKEN -u FLOW_HUB_TOKEN_FILE RAINDOWN_TASK_ID=t-orca-1 FLOW_TASK_ID=t-orca-1 RAINDOWN_WORKSPACE=ws/product-res FLOW_WORKSPACE=ws/product-res RAINDOWN_HOME=<root>/home FLOW_HOME=<root>/home RAINDOWN_LEASE_TOKEN_FILE=<root>/home/run/tasks/t-orca-1/dispatch-tokens/l-1.token FLOW_LEASE_TOKEN_FILE=<root>/home/run/tasks/t-orca-1/dispatch-tokens/l-1.token RAINDOWN_HUB_URL=http://127.0.0.1:7477 FLOW_HUB_URL=http://127.0.0.1:7477 RAINDOWN_ACTOR=dev FLOW_ACTOR=dev CODEX_HOME=<root>/home/run/executors/codex-orca/codex-home codex -m gpt-6.1-sol -c model_reasoning_effort=high --dangerously-bypass-approvals-and-sandbox -c 'mcp_servers.raindown={command="raindown",args=["mcp","--actor","dev","--task","t-orca-1"],env={RAINDOWN_HOME="<root>/home",RAINDOWN_ACTOR="dev"},env_vars=["RAINDOWN_LEASE_TOKEN_FILE","RAINDOWN_HUB_URL"],default_tools_approval_mode="approve"}' -c shell_environment_policy.ignore_default_excludes=false -c 'shell_environment_policy.exclude=["*KEY*","*SECRET*","*TOKEN*","RAINDOWN_LEASE_TOKEN_FILE"]' "$(cat <root>/home/state/tasks/t-orca-1/spec.md)""`;

